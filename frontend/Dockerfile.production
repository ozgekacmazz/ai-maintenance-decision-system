FROM node:22.22.0-alpine AS builder

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.28.2-alpine AS runtime

RUN rm -rf /usr/share/nginx/html/* \
    && mkdir -p /var/cache/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html /etc/nginx/conf.d
COPY --from=builder --chown=nginx:nginx /build/dist/ /usr/share/nginx/html/
COPY --chown=nginx:nginx deploy/nginx.conf /etc/nginx/nginx.conf
USER nginx
EXPOSE 8080
STOPSIGNAL SIGQUIT
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
