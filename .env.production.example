# Placeholders only. Copy to an ignored local secret source; never commit real values.
DJANGO_SECRET_KEY=<generate-at-least-50-random-characters>
DJANGO_ALLOWED_HOSTS=<public-hostname>
CSRF_TRUSTED_ORIGINS=https://<public-hostname>
PUBLIC_ORIGIN=https://<public-hostname>
POSTGRES_DB=sensor_production
POSTGRES_USER=sensor_production
POSTGRES_PASSWORD=<generate-a-strong-random-password>
POSTGRES_SSLMODE=require
ENABLE_API_DOCS=False
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
PROXY_PORT=18080

# Optional demo profile only; not required for normal production startup.
DEMO_ADMIN_USERNAME=<demo-admin-username>
DEMO_ADMIN_PASSWORD=<demo-admin-password>
DEMO_USER_USERNAME=<demo-user-username>
DEMO_USER_PASSWORD=<demo-user-password>
