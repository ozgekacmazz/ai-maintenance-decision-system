# Yalniz yerel gelistirme ornegidir; gercek ortamlarda benzersiz degerler kullanin.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=sensor_dev
POSTGRES_USER=sensor_dev
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Development/demo bootstrap; gerçek bilgileri yalnız izlenmeyen .env içinde tutun.
ADMIN_USERNAME=ornek-admin-kullanici-adi
ADMIN_EMAIL=
ADMIN_PASSWORD=ornek-guclu-parola-degeri

JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOGIN_THROTTLE_RATE=10/min
