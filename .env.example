# Yalniz yerel gelistirme ornegidir; gercek ortamlarda benzersiz degerler kullanin.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=sensor_dev
POSTGRES_USER=sensor_dev
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Development/demo bootstrap; gerçek bilgileri yalnız izlenmeyen .env içinde tutun.
ADMIN_USERNAME=ornek-admin-kullanici-adi
ADMIN_EMAIL=
ADMIN_PASSWORD=ornek-guclu-parola-degeri

# seed_demo giris hesaplari; gercek degerleri yalniz izlenmeyen .env'de tutun.
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=<set-a-strong-demo-password>
DEMO_USER_USERNAME=demo_operator
DEMO_USER_PASSWORD=<set-a-strong-demo-password>
# DEBUG=False ortaminda seed_demo icin bilincli opt-in gerekir.
ALLOW_DEMO_SEED_IN_PRODUCTION=False

JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOGIN_THROTTLE_RATE=10/min

# Model uygulama açılışında değil, ilk tahminde doğrulanarak yüklenir.
MODEL_ARTIFACT_PATH=/opt/ml/artifacts/binary-failure-1.0.0.joblib
MODEL_METADATA_PATH=/data/metadata/binary_failure_model.json
FAILURE_TYPE_MODEL_ARTIFACT_PATH=/opt/ml/artifacts/failure-type-1.0.0.joblib
FAILURE_TYPE_MODEL_METADATA_PATH=/data/metadata/failure_type_model.json
SHAP_TOP_N=3
REPLAY_PREPARED_DATASET_PATH=/data/processed/ai4i2020_prepared.csv
REPLAY_PREPARED_METADATA_PATH=/data/metadata/failure_label_analysis.json
